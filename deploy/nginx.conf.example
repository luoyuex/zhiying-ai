# 智盈 AI 生产站点 Nginx 示例
#
# 前端产物：npm run build 生成 frontend/dist
#   /          -> dist/index.html   产品官网（公开，SEO/GEO 入口）
#   /app/      -> dist/app.html     Vue 工作台（需登录）
#   /api/      -> 反代 FastAPI（127.0.0.1:8010）
#
# 两条铁律：
#   1. `/` 必须落到 index.html（官网）。不要把全局 fallback 指到 app.html。
#   2. `/app/*` 必须回退到 app.html，否则刷新工作台深链会 404 或落到官网。
#
# 使用：替换 server_name 与 root 后放到 /etc/nginx/conf.d/ 或 sites-available。

server {
    listen 80;
    server_name your-domain.com;              # TODO 换成你的域名
    root /var/www/zhiying/frontend/dist;      # TODO 换成 dist 的绝对路径
    index index.html;

    # 配好证书后可改成 443 server + 在这里 301 跳 HTTPS
    # return 301 https://$host$request_uri;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    client_max_body_size 10m;

    # HTML 不缓存，发版即生效
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location = /app.html {
        add_header Cache-Control "no-cache";
    }

    # 带指纹的构建产物：长缓存
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # 工作台：/app 301 到 /app/；/app/* 回退到 app.html
    location = /app {
        return 301 /app/;
    }
    location /app/ {
        try_files $uri /app.html;
    }

    # 后端 API。/api/v1/ai/jobs/{id}/events 是 SSE，必须关缓冲。
    location /api/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # 其余路径：先找静态文件，找不到回官网
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# HTTPS 版本（证书就绪后启用，并把上面的 80 server 改成 301 跳转）
#
# server {
#     listen 443 ssl;
#     http2 on;
#     server_name your-domain.com;
#     root /var/www/zhiying/frontend/dist;
#     index index.html;
#
#     ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
#
#     # ……其余 location 与上面完全一致，直接复制即可
# }
