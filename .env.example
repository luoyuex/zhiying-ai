# ---------- 数据库 / 缓存 ----------
DATABASE_URL=postgresql+asyncpg://zhiying:zhiying@localhost:5432/zhiying
REDIS_URL=redis://localhost:6379/0

# ---------- 安全密钥（生产必须换成随机串）----------
JWT_SECRET=change-me-to-a-random-64-char-hex-string
OTP_SECRET=change-me-to-another-random-64-char-hex-string

# ---------- Token 有效期 ----------
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------- 邮箱验证码 ----------
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_EMAIL_DAILY_LIMIT=10
OTP_IP_HOURLY_LIMIT=20

# ---------- 邮件发送 ----------
# smtp = 真实发信；console = 只打印到后端日志（本地无 SMTP 时用）
EMAIL_MODE=console
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
# 注意：是邮箱的「授权码」，不是登录密码
SMTP_PASSWORD=
SMTP_FROM_NAME=智赢 AI

# ---------- 行情数据源 ----------
# 公网共享出口被封时填代理，例如 http://user:pass@host:port；本地直连留空
EGRESS_PROXY_URL=
MARKET_HTTP_TIMEOUT=8
MARKET_PROVIDER_TIMEOUT=6
MARKET_GLOBAL_CONCURRENCY=8
MARKET_QUOTE_FRESH_SECONDS=3
MARKET_QUOTE_STALE_SECONDS=60
MARKET_KLINE_FRESH_SECONDS=300
MARKET_KLINE_STALE_SECONDS=1800
MARKET_CIRCUIT_FAILURES=5
MARKET_CIRCUIT_WINDOW_SECONDS=60
MARKET_CIRCUIT_OPEN_SECONDS=60

# ---------- LLM（OpenAI 兼容协议） ----------
# 填任意兼容 /chat/completions 的服务即可；DeepSeek 示例：https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=180
LLM_JOB_TIMEOUT_SECONDS=420
LLM_JOB_TTL_SECONDS=3600
LLM_ACTIVE_JOB_TTL_SECONDS=900
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.3
LLM_CACHE_SECONDS=21600

# ---------- 元宝搜索（腾讯云联网搜索 WSA） ----------
# 官方腾讯云 API 3.0（推荐）：SecretId / SecretKey，TC3 签名，Host=wsa.tencentcloudapi.com
# 注意：不是 You.com 的 YDC_API_KEY；SecretId 形如 AKID…，服务 API KEY 形如 sk-…
WSA_SECRET_ID=
WSA_SECRET_KEY=
# 临时密钥才需要；长期密钥留空
WSA_SECRET_TOKEN=
WSA_SEARCH_HOST=wsa.tencentcloudapi.com
WSA_SEARCH_VERSION=2025-05-08
# 兼容服务 API KEY（Bearer）模式；与 SecretId/SecretKey 二选一，同时填时优先官方 API
WSA_API_KEY=
WSA_SEARCH_URL=https://api.wsa.cloud.tencent.com/SearchPro
WSA_SEARCH_TIMEOUT_SECONDS=20
WSA_SEARCH_COUNT=20
WSA_SEARCH_TOP_N=8
# 时效范围：d1-30 / m1-12 / y1-5 / yyyy-mm-dd / yyyy-mm-dd,yyyy-mm-dd；留空不限
WSA_SEARCH_FRESHNESS=m3
WSA_SEARCH_CACHE_SECONDS=1800

# ---------- 应用 ----------
APP_NAME=智赢 AI
CORS_ORIGINS=http://localhost:5288,http://127.0.0.1:5288
COOKIE_SECURE=false
DEBUG=true

# ---------- LLM（OpenAI 兼容协议，P4 Agent 编排时启用） ----------
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_API_KEY=
LLM_MODEL=sensenova-6.8-flash-lite
