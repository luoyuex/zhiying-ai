# ---------- 数据库 / 缓存 ----------
DATABASE_URL=postgresql+asyncpg://zhiying:zhiying@localhost:5432/zhiying
REDIS_URL=redis://localhost:6379/0

# ---------- 安全密钥（生产必须换成随机串）----------
JWT_SECRET=change-me-to-a-random-64-char-hex-string
OTP_SECRET=change-me-to-another-random-64-char-hex-string

# ---------- Token 有效期 ----------
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------- 邮箱验证码 ----------
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_EMAIL_DAILY_LIMIT=10
OTP_IP_HOURLY_LIMIT=20

# ---------- 邮件发送 ----------
# smtp = 真实发信；console = 只打印到后端日志（本地无 SMTP 时用）
EMAIL_MODE=console
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
# 注意：是邮箱的「授权码」，不是登录密码
SMTP_PASSWORD=
SMTP_FROM_NAME=智盈 AI

# 邮件里的报告链接前缀（生产填站点根地址，不带 /app）
PUBLIC_APP_URL=http://127.0.0.1:5288
# 定时任务结果邮件：等待当天任务全部完成的最长分钟数，超时先发已完成部分
AUTOMATION_MAIL_WAIT_MINUTES=120

# ---------- 行情数据源 ----------
# 单代理/旧配置：代理池关闭时对所有行情请求生效；本地直连留空
EGRESS_PROXY_URL=
# 出站代理池总开关（默认关闭，关闭时行为与原来完全一致）
EGRESS_PROXY_ENABLED=false
# 来源：static=固定入口/隧道；api=服务商提取接口
EGRESS_PROXY_SOURCE=static
# --- 固定入口 / 隧道（source=static 时使用）---
# 代理入口，逗号分隔；隧道代理填一个固定 host:port 即可
# 例：http://user:pass@tps.example.com:15818
# socks5 入口需额外安装：uv add "httpx[socks]"
EGRESS_PROXY_STATIC=
# 隧道入口背后由服务商换 IP：被目标站封时只重试，不冷却整个入口
EGRESS_PROXY_ROTATE_PER_REQUEST=true
EGRESS_PROXY_MAX_ATTEMPTS=2
EGRESS_PROXY_COOLDOWN_SECONDS=60
EGRESS_PROXY_BAN_SECONDS=900
# --- 提取 API（source=api 时使用）---
# 服务商给的完整提取链接（含 uid/vkey，属于密钥，不要提交或打印）
# 若链接是 http://，vkey 会明文经过网络；只在可信网络使用并定期轮换
EGRESS_PROXY_API_URL=
# 提取 IP 有效期 30s 时用 25s（提前 5 秒换）；按服务商实际有效期调整
EGRESS_PROXY_API_TTL_SECONDS=25
# 提取失败后的冷却，避免连续打爆服务商接口
EGRESS_PROXY_API_ERROR_COOLDOWN_SECONDS=5
# 每个代理入口的限速（单隧道时即隧道总速率；0=不限）
EGRESS_PROXY_PER_IP_RATE=2
EGRESS_PROXY_PER_IP_BURST=4
# 走代理的行情源：eastmoney,tencent,sina；空=全部
EGRESS_PROXY_PROVIDERS=
MARKET_HTTP_TIMEOUT=8
MARKET_PROVIDER_TIMEOUT=6
MARKET_GLOBAL_CONCURRENCY=8
MARKET_QUOTE_FRESH_SECONDS=3
MARKET_QUOTE_STALE_SECONDS=60
MARKET_KLINE_FRESH_SECONDS=300
MARKET_KLINE_STALE_SECONDS=1800
MARKET_CIRCUIT_FAILURES=5
MARKET_CIRCUIT_WINDOW_SECONDS=60
MARKET_CIRCUIT_OPEN_SECONDS=60
MARKET_NEWS_CACHE_SECONDS=600
MARKET_NEWS_AI_CACHE_SECONDS=21600

# ---------- LLM（OpenAI 兼容协议） ----------
# 填任意兼容 /chat/completions 的服务即可；DeepSeek 示例：https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=180
LLM_ANALYST_TIMEOUT_SECONDS=150
LLM_ANALYST_CONCURRENCY=3
LLM_JOB_TIMEOUT_SECONDS=600
LLM_JOB_TTL_SECONDS=3600
LLM_ACTIVE_JOB_TTL_SECONDS=900
LLM_MAX_TOKENS=8192
# 推理力度：default/none/low/medium/high。default 不传参；
# SenseNova 会自动用 none（避免思考吃光正文额度），其他模型按需显式设置
LLM_REASONING_EFFORT=default
LLM_FINAL_REASONING_EFFORT=default
# 选股分析师 / 最终精选输出上限（模型最大输出通常为 64K，按需调整）
LLM_ANALYST_MAX_TOKENS=8000
LLM_FINAL_MAX_TOKENS=16000
LLM_TEMPERATURE=0.3
LLM_CACHE_SECONDS=21600

# ---------- AI 任务执行 ----------
# arq：独立 worker 进程（生产/联调推荐）；inline：本地临时调试，进程重启会中断任务
AI_JOB_EXECUTION=arq
AI_WORKER_MAX_JOBS=2
AI_WORKER_HEARTBEAT_TTL_SECONDS=120
# 开发期额度覆盖：>0 时所有用户统一按该值；0 表示使用用户表的 daily_analysis_quota
AI_DAILY_QUOTA_OVERRIDE=0

# ---------- 元宝搜索（腾讯云联网搜索 WSA） ----------
# 官方腾讯云 API 3.0（推荐）：SecretId / SecretKey，TC3 签名，Host=wsa.tencentcloudapi.com
# 注意：不是 You.com 的 YDC_API_KEY；SecretId 形如 AKID…，服务 API KEY 形如 sk-…
WSA_SECRET_ID=
WSA_SECRET_KEY=
# 临时密钥才需要；长期密钥留空
WSA_SECRET_TOKEN=
WSA_SEARCH_HOST=wsa.tencentcloudapi.com
WSA_SEARCH_VERSION=2025-05-08
# 兼容服务 API KEY（Bearer）模式；与 SecretId/SecretKey 二选一，同时填时优先官方 API
WSA_API_KEY=
WSA_SEARCH_URL=https://api.wsa.cloud.tencent.com/SearchPro
WSA_SEARCH_TIMEOUT_SECONDS=20
WSA_SEARCH_COUNT=20
WSA_SEARCH_TOP_N=8
# 时效范围：d1-30 / m1-12 / y1-5 / yyyy-mm-dd / yyyy-mm-dd,yyyy-mm-dd；留空不限
WSA_SEARCH_FRESHNESS=m3
WSA_SEARCH_CACHE_SECONDS=1800

# ---------- 应用 ----------
APP_NAME=智盈 AI
CORS_ORIGINS=http://localhost:5288,http://127.0.0.1:5288
COOKIE_SECURE=false
DEBUG=true

# ---------- 日志落盘 ----------
# API 写 backend/logs/app.log，worker 写 backend/logs/worker.log；相对 backend 目录，绝对路径亦可
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ---------- 定时任务 ----------
# 调度器每 5 分钟触发一次；用户在个人中心按任务线自定义执行时间，
# 此处仅为新用户的默认时间（AUTOMATION_CRON_MINUTE 会被 5 整除最利于对齐）
AUTOMATION_CRON_HOUR=17
AUTOMATION_CRON_MINUTE=35
