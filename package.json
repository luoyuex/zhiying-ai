{
  "name": "zhiying-ai",
  "version": "0.1.0",
  "private": true,
  "description": "智盈 AI —— A 股 AI 分析工作台",
  "scripts": {
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "api": "uv run --directory backend uvicorn app.main:app --reload --reload-dir app --host 127.0.0.1 --port 8010",
    "worker": "uv run --directory backend arq app.worker.WorkerSettings",
    "web": "npm --prefix frontend run dev",
    "migrate": "uv run --directory backend alembic upgrade head",
    "seed": "uv run --directory backend python -m app.scripts.seed_stocks",
    "revision": "uv run --directory backend alembic revision --autogenerate -m",
    "test": "uv run --directory backend pytest -q",
    "build": "npm --prefix frontend run build"
  }
}
